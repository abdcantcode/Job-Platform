PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local), e.g. mongodb://localhost:27017/job-tracker
MONGO_URI=

# Any long random string. Keep it private.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS. Separate several with commas.
CLIENT_URL=http://localhost:5173

# Email reminders (Nodemailer). For Gmail: smtp.gmail.com, port 587,
# your address, and an App Password (needs 2-step verification on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Reminder job: daily at 9:00 in REMINDER_TZ, for applications idle this many days.
REMINDER_CRON="0 9 * * *"
REMINDER_TZ=Asia/Kolkata
REMINDER_STALE_DAYS=7
